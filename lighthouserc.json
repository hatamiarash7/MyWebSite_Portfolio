{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/projects.html",
        "http://localhost/projects/webhook-handler.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 51200
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 30720
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 153600
          }
        ],
        "resource-summary:third-party:count": [
          "warn",
          {
            "maxNumericValue": 10
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}