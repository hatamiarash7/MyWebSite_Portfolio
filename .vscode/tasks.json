{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "jekyll",
      "type": "shell",
      "command": "make run",
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server address:"
        }
      }
    }
  ]
}
