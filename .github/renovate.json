{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "assignees": [
    "hatamiarash7"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "groupName": "astro",
      "matchPackageNames": [
        "astro",
        "@astrojs/**",
        "astro-icon",
        "prettier-plugin-astro"
      ]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "prettier-plugin-tailwindcss"
      ]
    },
    {
      "groupName": "iconify sets",
      "matchPackageNames": [
        "@iconify-json/**"
      ],
      "automerge": true
    },
    {
      "groupName": "docker images",
      "matchDatasources": [
        "docker"
      ]
    }
  ]
}