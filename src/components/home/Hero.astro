---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import portrait from "@/assets/images/profile.jpg";
import { profile, site } from "@/data/site";
---

<section class="grid gap-4 md:grid-cols-12" aria-labelledby="hero-title">
  <div class="tile flex flex-col justify-between gap-10 p-7 sm:p-10 md:col-span-8">
    <div
      class="grid-pattern absolute inset-0 mask-[radial-gradient(ellipse_at_0%_0%,#000,transparent_70%)]"
      aria-hidden="true"
    ></div>
    <div class="glow absolute -top-40 -left-40 size-[32rem]" aria-hidden="true"></div>

    <div class="relative">
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-border bg-surface-2/80 px-3 py-1">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        {profile.eyebrow}
      </p>
      <h1 id="hero-title" class="mt-6 text-display font-black">
        {site.name}
      </h1>
      <p class="mt-3 text-xl font-medium text-accent sm:text-2xl">{profile.role}</p>
      <p class="mt-6 max-w-2xl text-base text-fg-muted sm:text-lg">{profile.bio}</p>
    </div>

    <div class="relative flex flex-wrap items-center gap-3">
      <a href="/projects" class="btn-primary max-sm:w-full" data-astro-prefetch>
        مشاهده پروژه‌ها
        <Icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
      </a>
      <a href="#contact" class="btn-ghost max-sm:w-full">
        <Icon name="tabler:mail" class="size-4" aria-hidden="true" />
        ارتباط با من
      </a>
    </div>
  </div>

  <div class="tile aspect-square md:col-span-4 md:aspect-auto">
    <Picture
      src={portrait}
      alt={`تصویر ${site.name}`}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[360, 500]}
      layout="none"
      sizes="(min-width: 1200px) 384px, (min-width: 768px) 33vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover object-[50%_35%]"
      pictureAttributes={{ class: "contents" }}
    />
    <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 to-transparent p-5 pt-16" dir="ltr">
      <p class="font-mono text-sm text-white/90">@{profile.handle}</p>
    </div>
  </div>
</section>
