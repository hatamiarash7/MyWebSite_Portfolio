---
import { Icon } from "astro-icon/components";
import { site, socials } from "@/data/site";

const year = new Intl.DateTimeFormat("fa-IR-u-ca-persian", { year: "numeric" }).format(new Date());
---

<footer class="mt-24 border-t border-border">
  <div class="container-site flex flex-col items-center justify-between gap-6 py-8 text-sm text-fg-subtle sm:flex-row">
    <p>
      © {year}
      {site.name}. کد منبع این سایت
      <a href={site.repository} class="text-fg-muted underline-offset-4 hover:text-accent hover:underline">
        در گیت‌هاب
      </a>
      در دسترس است.
    </p>
    <ul class="flex items-center gap-1">
      {socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="me noopener"
            class="grid size-9 place-items-center rounded-full transition-colors hover:bg-surface-2 hover:text-fg"
            aria-label={social.label}
          >
            <Icon name={social.icon} class="size-4" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
