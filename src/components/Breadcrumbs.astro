---
import { Icon } from "astro-icon/components";
import type { Crumb } from "@/lib/seo";

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="مسیر صفحه" class="text-sm text-fg-subtle">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {isLast ? (
            <span aria-current="page" class="line-clamp-1 text-fg-muted">
              {crumb.label}
            </span>
          ) : (
            <>
              <a href={crumb.href} class="transition-colors hover:text-accent" data-astro-prefetch>
                {crumb.label}
              </a>
              <Icon name="tabler:chevron-left" class="size-3.5" aria-hidden="true" />
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
