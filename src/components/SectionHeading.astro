---
import { Icon } from "astro-icon/components";

export interface Props {
  id: string;
  eyebrow: string;
  title: string;
  link?: { href: string; label: string };
}

const { id, eyebrow, title, link } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id} class="mt-1 text-2xl font-black sm:text-3xl">
      {title}
    </h2>
  </div>
  {link && (
    <a
      href={link.href}
      class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-fg-muted transition-colors hover:text-accent"
      data-astro-prefetch
    >
      {link.label}
      <Icon
        name="tabler:arrow-left"
        class="size-4 transition-transform duration-300 group-hover:-translate-x-1"
        aria-hidden="true"
      />
    </a>
  )}
</div>
