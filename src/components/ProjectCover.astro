---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { stackIcon } from "@/data/stack-icons";

export interface Props {
  project: CollectionEntry<"projects">;
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { project, sizes, loading = "lazy", class: className } = Astro.props;
const { cover, title, stack, links } = project.data;

const repo = links.find((link) => link.kind === "repo")?.url.replace(/^https:\/\/github\.com\//, "");
const [owner, name] = repo ? repo.split("/") : ["~", project.id];
const icons = stack
  .map(stackIcon)
  .filter((icon): icon is string => Boolean(icon))
  .slice(0, 3);
const transitionName = `cover-${project.id}`;
---

<div
  class:list={["relative aspect-16/10 overflow-hidden bg-surface-2", className]}
  style={`view-transition-name: ${transitionName}`}
>
  {cover ? (
    <Picture
      src={cover}
      alt={title}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[400, 640, 960, 1280].filter((width) => width <= cover.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : "auto"}
      class="size-full object-cover"
      pictureAttributes={{ class: "contents" }}
    />
  ) : (
    <div class="grid-pattern absolute inset-0 flex flex-col items-center justify-center gap-4 p-6" dir="ltr">
      <div class="glow absolute -top-1/2 left-1/2 size-[140%] -translate-x-1/2" aria-hidden="true" />
      {icons.length > 0 && (
        <div class="relative flex items-center gap-3 text-fg-muted" aria-hidden="true">
          {icons.map((icon) => (
            <Icon name={icon} class="size-7" />
          ))}
        </div>
      )}
      <p class="relative max-w-full truncate font-mono text-sm text-fg">
        <span class="text-fg-subtle">{owner}/</span>
        {name}
      </p>
    </div>
  )}
</div>
