---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="صفحه پیدا نشد" description="صفحه‌ای که دنبالش بودید وجود ندارد یا جابه‌جا شده است." noindex>
  <div class="container-site pt-6 sm:pt-10">
    <section class="tile grid-pattern relative flex flex-col items-center px-6 py-20 text-center sm:py-28">
      <div class="glow absolute -top-1/3 left-1/2 size-[120%] -translate-x-1/2" aria-hidden="true"></div>
      <p class="relative font-mono text-7xl font-bold text-accent sm:text-8xl" dir="ltr">404</p>
      <h1 class="relative mt-6 text-3xl font-black sm:text-4xl">صفحه پیدا نشد</h1>
      <p class="relative mt-4 max-w-md text-fg-muted">
        صفحه‌ای که دنبالش بودید وجود ندارد یا جابه‌جا شده است. از صفحه اصلی یا فهرست پروژه‌ها ادامه دهید.
      </p>
      <div class="relative mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
        <a href="/" class="btn-primary">
          <Icon name="tabler:home" class="size-4.5" aria-hidden="true" />
          صفحه اصلی
        </a>
        <a href="/projects" class="btn-ghost">
          <Icon name="tabler:layout-grid" class="size-4.5" aria-hidden="true" />
          همه پروژه‌ها
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
