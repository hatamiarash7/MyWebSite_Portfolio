---
import portrait from "@/assets/images/profile.jpg";
import Contact from "@/components/home/Contact.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import Hero from "@/components/home/Hero.astro";
import Skills from "@/components/home/Skills.astro";
import Stats from "@/components/home/Stats.astro";
import Timeline from "@/components/home/Timeline.astro";
import { experience } from "@/data/experience";
import { profile, site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/projects";
import { socialImage } from "@/lib/seo";

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const openSourceCount = projects.filter((project) => project.data.openSource).length;
const hasTimeline = experience.some((entry) => import.meta.env.DEV || !entry.placeholder);
const portraitUrl = (await socialImage(portrait, 500)).url;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    alternateName: site.nameEn,
    inLanguage: "fa-IR",
    publisher: { "@id": `${site.url}/#person` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.name,
    alternateName: site.nameEn,
    url: site.url,
    image: portraitUrl,
    email: `mailto:${profile.email}`,
    jobTitle: profile.role,
    description: profile.bio,
    sameAs: profile.sameAs,
    knowsAbout: ["DevOps", "Docker", "CI/CD", "Linux", "Go", "Python", "Networking"],
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container-site flex flex-col gap-4 pt-6 sm:pt-10">
    <Hero />
    <Stats projectCount={projects.length} openSourceCount={openSourceCount} />
  </div>

  <div class="container-site mt-20">
    <FeaturedProjects projects={featured} />
  </div>

  <div class="container-site mt-20 grid gap-4 lg:grid-cols-12">
    <section class:list={[hasTimeline ? "lg:col-span-7" : "lg:col-span-12"]} aria-labelledby="skills-title">
      <Skills />
    </section>
    {hasTimeline && (
      <section class="lg:col-span-5" aria-labelledby="experience-title">
        <Timeline />
      </section>
    )}
  </div>

  <div class="container-site mt-4">
    <Contact />
  </div>
</BaseLayout>
